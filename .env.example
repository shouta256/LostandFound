# Copy this file to .env (cp .env.example .env). Never commit .env.
# Development-only defaults, used by docker-compose.yml and later by the backend.
POSTGRES_USER=lostandfound
POSTGRES_PASSWORD=lostandfound
POSTGRES_DB=lostandfound
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Shared development Google OAuth web client ID (public; safe to commit).
# The project owner fills this in once for the team.
GOOGLE_CLIENT_ID=415533015421-9pjmccb6j2ae1inf6uesqic7jgm4fsic.apps.googleusercontent.com
# Leave blank here. make setup generates a different private key in each local .env.
# Production must use its own key stored in the deployment platform's secrets.
AUTH_SECRET_KEY=
